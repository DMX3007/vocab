# Copy to .env for local dev (NestJS doesn't load .env by default here —
# export these into the shell, or add a dotenv loader, before running
# start:dev if you want to exercise the Ko-fi/email paths locally).
#
# In production every one of these except PORT is required — see the
# comments at each use site (licenses.module.ts, email.service.ts,
# kofi.controller.ts) for what breaks if it's missing.

# Port the NestJS server listens on. Defaults to 3000 if unset.
PORT=3000

# Path to the SQLite file backing license storage. MUST be set to a path on
# a persistent volume in production — licenses.module.ts refuses to boot in
# production (NODE_ENV=production) without it, since the ':memory:' fallback
# forgets every issued license on every restart.
LICENSE_DB_PATH=./data/licenses.sqlite

# Shared secret configured in the Ko-fi webhook settings
# (https://ko-fi.com/manage/webhooks). Incoming webhook payloads whose
# verification_token doesn't match this are rejected.
KOFI_VERIFICATION_TOKEN=

# Resend (https://resend.com) API key used to email out license keys after
# a purchase. If unset, license issuance still succeeds but the delivery
# email silently fails to send (logged as an error server-side) — see
# email.service.ts.
RESEND_API_KEY=

# From address for delivery emails, e.g. "Vocably <licenses@yourdomain.com>".
# Must be a verified sender/domain in Resend.
EMAIL_FROM=

# Standard Node environment flag. Set to "production" on any real deploy —
# this gates the LICENSE_DB_PATH fail-fast check above.
NODE_ENV=development
